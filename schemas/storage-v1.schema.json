{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sleeper-draft-command-center/storage-v1.schema.json",
  "title": "Sleeper Draft Command Center local storage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "user", "ranking_profiles", "draft_sessions", "settings"],
  "properties": {
    "schema_version": { "const": 1 },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "user_id"],
      "properties": {
        "username": { "type": "string", "maxLength": 50 },
        "user_id": { "type": "string", "maxLength": 80 }
      }
    },
    "ranking_profiles": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/ranking_profile" }
    },
    "draft_sessions": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": { "$ref": "#/$defs/draft_session" }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_ranking_profile_id", "last_draft_id", "theme", "dock", "poll_interval_ms"],
      "properties": {
        "active_ranking_profile_id": { "type": ["string", "null"], "maxLength": 80 },
        "last_draft_id": { "type": ["string", "null"], "maxLength": 80 },
        "theme": { "const": "command_center" },
        "dock": { "enum": ["left", "right"] },
        "poll_interval_ms": { "type": "integer", "minimum": 250, "maximum": 60000 }
      }
    }
  },
  "$defs": {
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "player", "position", "team", "sleeper_id", "adp", "tier", "notes"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "player": { "type": "string", "minLength": 1, "maxLength": 100 },
        "position": { "enum": ["QB", "RB", "WR", "TE", "K", "DEF"] },
        "team": { "type": "string", "maxLength": 5 },
        "sleeper_id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "adp": { "type": ["number", "null"], "minimum": 0 },
        "tier": { "type": ["integer", "null"], "minimum": 1 },
        "notes": { "type": "string", "maxLength": 300 }
      }
    },
    "league_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teams", "roster_positions", "scoring"],
      "properties": {
        "teams": { "type": ["integer", "null"], "minimum": 2, "maximum": 32 },
        "roster_positions": {
          "type": "array",
          "maxItems": 40,
          "items": { "type": "string", "maxLength": 30 }
        },
        "scoring": {
          "type": "object",
          "maxProperties": 150,
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "ranking_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "format", "source", "created_at", "updated_at", "league_settings", "players"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "format": { "enum": ["one_qb", "superflex", "best_ball", "custom"] },
        "source": { "enum": ["public_adp", "paste", "csv", "json", "manual"] },
        "created_at": { "type": ["string", "null"], "format": "date-time" },
        "updated_at": { "type": ["string", "null"], "format": "date-time" },
        "league_settings": { "$ref": "#/$defs/league_settings" },
        "players": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/player" }
        }
      }
    },
    "manual_pick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pick_no", "draft_slot", "roster_id", "picked_by", "player_id", "metadata"],
      "properties": {
        "pick_no": { "type": "integer", "minimum": 1, "maximum": 1600 },
        "draft_slot": { "type": "integer", "minimum": 1, "maximum": 32 },
        "roster_id": { "type": ["integer", "null"], "minimum": 1 },
        "picked_by": { "type": "string", "maxLength": 80 },
        "player_id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_name", "last_name", "position", "team"],
          "properties": {
            "first_name": { "type": "string", "maxLength": 50 },
            "last_name": { "type": "string", "maxLength": 80 },
            "position": { "type": "string", "maxLength": 5 },
            "team": { "type": "string", "maxLength": 5 }
          }
        }
      }
    },
    "cached_live_pick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pick_no", "draft_slot", "roster_id", "picked_by", "player_id", "metadata"],
      "properties": {
        "pick_no": { "type": "integer", "minimum": 1, "maximum": 1600 },
        "draft_slot": { "type": ["integer", "null"], "minimum": 1, "maximum": 32 },
        "roster_id": { "type": ["integer", "null"], "minimum": 1 },
        "picked_by": { "type": "string", "maxLength": 80 },
        "player_id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_name", "last_name", "position", "team"],
          "properties": {
            "first_name": { "type": "string", "maxLength": 50 },
            "last_name": { "type": "string", "maxLength": 80 },
            "position": { "type": "string", "maxLength": 5 },
            "team": { "type": "string", "maxLength": 5 }
          }
        }
      }
    },
    "draft_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "status", "format", "teams", "rounds", "reversal_round", "pick_timer", "user_slot", "user_roster_id", "roster_positions", "scoring"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": { "const": "snake" },
        "status": { "type": "string", "maxLength": 30 },
        "format": { "enum": ["one_qb", "superflex", "best_ball", "custom"] },
        "teams": { "type": ["integer", "null"], "minimum": 2, "maximum": 32 },
        "rounds": { "type": ["integer", "null"], "minimum": 1, "maximum": 50 },
        "reversal_round": { "type": "integer", "minimum": 0, "maximum": 50 },
        "pick_timer": { "type": ["integer", "null"], "minimum": 0, "maximum": 86400 },
        "user_slot": { "type": ["integer", "null"], "minimum": 1, "maximum": 32 },
        "user_roster_id": { "type": ["integer", "null"], "minimum": 1 },
        "traded_picks": {
          "type": "array",
          "maxItems": 1600,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["round", "roster_id", "owner_id"],
            "properties": {
              "round": { "type": "integer", "minimum": 1, "maximum": 50 },
              "roster_id": { "type": "integer", "minimum": 1 },
              "owner_id": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "roster_positions": {
          "type": "array",
          "maxItems": 40,
          "items": { "type": "string", "maxLength": 30 }
        },
        "scoring": {
          "type": "object",
          "maxProperties": 150,
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "draft_session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_id", "league_id", "ranking_profile_id", "mode", "manual_picks", "cached_live_picks", "draft_config", "pinned_player_ids", "ui", "last_synced_at", "updated_at"],
      "properties": {
        "draft_id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "league_id": { "type": "string", "maxLength": 80 },
        "ranking_profile_id": { "type": ["string", "null"], "maxLength": 80 },
        "mode": { "enum": ["live", "manual"] },
        "manual_picks": {
          "type": "array",
          "maxItems": 1600,
          "items": { "$ref": "#/$defs/manual_pick" }
        },
        "cached_live_picks": {
          "type": "array",
          "maxItems": 1600,
          "items": { "$ref": "#/$defs/cached_live_pick" }
        },
        "draft_config": { "$ref": "#/$defs/draft_config" },
        "pinned_player_ids": {
          "type": "array",
          "maxItems": 1000,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fullscreen", "dock", "active_tab"],
          "properties": {
            "fullscreen": { "type": "boolean" },
            "dock": { "enum": ["left", "right"] },
            "active_tab": { "enum": ["shortlist", "board", "room", "roster", "manual", "offline"] }
          }
        },
        "last_synced_at": { "type": ["string", "null"], "format": "date-time" },
        "updated_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
